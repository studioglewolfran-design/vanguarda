# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use "demo" until the Supabase workspace is provisioned. Use "supabase" only
# after applying the private workspace migration and importing reviewed data.
STUDIO_OS_DATA_MODE=demo

# Somente local: use "disabled" para abrir /os sem login durante o desenvolvimento.
# Em producao, o codigo ignora este valor e mantem a autenticacao obrigatoria.
STUDIO_OS_AUTH_MODE=

# Formspree — override opcional do formulario "Exame Lorrana"
FORMSPREE_LORRANA_FORM_ID=

# Formspree — briefing modelo de direcionamento profissional
FORMSPREE_BRIEFING_PROFISSIONAL_FORM_ID=

# Formspree — briefing-piloto específico de Lorrana (recomendado separar do Exame)
FORMSPREE_LORRANA_BRIEFING_FORM_ID=
